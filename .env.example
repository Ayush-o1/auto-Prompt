# Environment Variable Reference — AutoPrompt
# Copy this file to .env and fill in the required values.
#   cp .env.example .env
# Never commit your .env file. It is listed in .gitignore.

# ─────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────

# Google AI Studio API key.
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here


# ─────────────────────────────────────────────────────────────
# DATABASE (optional)
# ─────────────────────────────────────────────────────────────

# SQLAlchemy-compatible database URL.
# Default: SQLite file in the project root (zero infrastructure).
# To use PostgreSQL: postgresql://user:password@host:5432/dbname
# DATABASE_URL=sqlite:///autoprompt.db


# ─────────────────────────────────────────────────────────────
# LOGGING (optional)
# ─────────────────────────────────────────────────────────────

# Loguru log level: TRACE | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL
# Default: INFO
# LOG_LEVEL=INFO


# ─────────────────────────────────────────────────────────────
# API SERVER (optional)
# ─────────────────────────────────────────────────────────────

# Port for the FastAPI/Uvicorn server.
# Default: 8000
# API_PORT=8000

# Number of Uvicorn worker processes (production only).
# Default: 1 (use more in production behind a load balancer)
# API_WORKERS=1


# ─────────────────────────────────────────────────────────────
# STREAMLIT (optional)
# ─────────────────────────────────────────────────────────────

# Port for the Streamlit demo server.
# Default: 8501
# STREAMLIT_SERVER_PORT=8501
